model User {
    id             String    @id @default(uuid())
    name           String?
    email          String    @unique
    password       String
    role           Role      @default(CUSTOMER)
    avatar         String?
    avatarPublicId String?
    isVerified     Boolean   @default(false)
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt
    cart           Cart?
    addresses      Address[]
    orders         Order[]
    payments       Payment[]
}
