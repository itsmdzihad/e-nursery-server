          <!-- Email Container -->
          <table
            role="presentation"
            width="100%"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="
              max-width: 600px;
              background-color: #ffffff;
              border-radius: 12px;
              overflow: hidden;
            "
          >
            <!-- Header -->
            <tr>
              <td
                align="center"
                style="padding: 30px 20px; background-color: #2e7d32"
              >
                <h1
                  style="
                    margin: 0;
                    color: #ffffff;
                    font-size: 28px;
                    font-weight: bold;
                  "
                >
                  🌱 e-nursery
                </h1>

                <p style="margin: 8px 0 0; color: #e8f5e9; font-size: 14px">
                  Grow Your Green World
                </p>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding: 40px 30px">
                <h2 style="margin: 0 0 15px; color: #1f2937; font-size: 24px">
                  Hello <%= name %> 👋
                </h2>

                <p
                  style="
                    margin: 0 0 20px;
                    color: #4b5563;
                    font-size: 16px;
                    line-height: 1.6;
                  "
                >
                  Thank you for using <strong>e-nursery</strong>. Please use the
                  following One-Time Password (OTP) to complete your
                  verification.
                </p>

                <!-- OTP Box -->
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="
                    margin: 30px 0;
                    background-color: #f0fdf4;
                    border: 1px solid #bbf7d0;
                    border-radius: 10px;
                  "
                >
                  <tr>
                    <td align="center" style="padding: 25px">
                      <p
                        style="
                          margin: 0 0 10px;
                          color: #166534;
                          font-size: 14px;
                          font-weight: bold;
                        "
                      >
                        YOUR VERIFICATION CODE
                      </p>

                      <div
                        style="
                          font-size: 36px;
                          font-weight: bold;
                          letter-spacing: 8px;
                          color: #15803d;
                        "
                      >
                        <%= otp %>
                      </div>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin: 0 0 15px;
                    color: #4b5563;
                    font-size: 15px;
                    line-height: 1.6;
                  "
                >
                  This OTP will expire in
                  <strong><%= expiryMinutes %> minutes</strong>.
                </p>

                <p
                  style="
                    margin: 0;
                    color: #6b7280;
                    font-size: 14px;
                    line-height: 1.6;
                  "
                >
                  🔒 For your security, please do not share this code with
                  anyone. e-nursery will never ask you for your OTP.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="
                  padding: 25px 20px;
                  background-color: #f9fafb;
                  border-top: 1px solid #e5e7eb;
                "
              >
                <p style="margin: 0 0 8px; color: #6b7280; font-size: 13px">
                  If you did not request this verification code, you can safely
                  ignore this email.
                </p>
